  ],
  "shortcuts": [
    {
      "name": "Iniciar Sesión",
      "short_name": "Login",
      "description": "Acceder al sistema de Gemelos Digitales",
      "url": "/",
      "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Panel de Control",
      "short_name": "Dashboard",
